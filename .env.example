# Copy to .env and adjust. Every value here is free / local by default.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO

# App database. SQLite needs no server. For Postgres (e.g. Neon free tier), paste the
# connection string as-is; plain postgresql:// URLs are switched to the psycopg 3 driver.
# Use Neon's direct endpoint (not "-pooler") for this long-running server.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./data/askdata.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM: ollama (local, default) | gemini (free tier) | groq (free tier)
LLM_PROVIDER=ollama
# Empty = the provider's default: ollama qwen2.5:7b-instruct, gemini gemini-2.5-flash, groq openai/gpt-oss-120b
LLM_MODEL=
# Backup provider used when LLM_PROVIDER fails or hits its free-tier limit (e.g. groq).
LLM_FALLBACK_PROVIDER=
# Model for the 2-3 sentence summaries. Empty = gemini-3.5-flash-lite on Gemini (its own
# free-tier quota), otherwise the same model as LLM_MODEL.
LLM_SUMMARY_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Laptop with a small GPU (e.g. 2 GB)? Set 0 to run on the CPU and avoid "CUDA out of memory".
OLLAMA_NUM_GPU=
OLLAMA_TIMEOUT_SECONDS=300
GEMINI_API_KEY=
GROQ_API_KEY=

# Uploaded datasets
DATA_DIR=./data
MAX_UPLOAD_MB=20
# local = disk only. s3 = also keep files in S3-compatible storage (e.g. Neon), required on
# hosts whose disk is wiped on restart (Render free plan). The disk then acts as a cache.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
