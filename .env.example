# Copy to .env and adjust. Every value here is free / local by default.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO

# App database. SQLite needs no server. For Postgres (e.g. Neon/Supabase free tier):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/askdata
DATABASE_URL=sqlite:///./data/askdata.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM: ollama (local, default) | gemini (free tier) | groq (free tier)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=

# Uploaded datasets
DATA_DIR=./data
MAX_UPLOAD_MB=20
